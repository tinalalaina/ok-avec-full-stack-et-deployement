# Django
SECRET_KEY=change-me
DEBUG=False

# Frontend public URL (Cloudflare Pages)
FRONTEND_URL=https://ok-avec-full-stack-et-deployement.pages.dev

# Database (Render PostgreSQL externe)
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
DB_HOST=your-render-hostname.render.com
DB_PORT=5432
DB_SSLMODE=require

# Alternative unique URL (prioritaire si définie)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# CORS / CSRF
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=https://ok-avec-full-stack-et-deployement.pages.dev
CSRF_TRUSTED_ORIGINS=https://ok-avec-full-stack-et-deployement.pages.dev

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
